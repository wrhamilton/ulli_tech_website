{
  "name": "code",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check:node": "node -e \"const major=Number(process.versions.node.split('.')[0]); if (major < 24) { console.error('This project requires Node 24+. Current version: ' + process.versions.node); process.exit(1); }\"",
    "dev": "npm run check:node && astro dev",
    "build": "npm run check:node && astro build",
    "preview": "npm run check:node && astro preview",
    "astro": "astro",
    "check": "npm run check:node && astro check"
  },
  "dependencies": {
    "astro": "^7.4.4"
  },
  "devDependencies": {
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2"
  }
}
