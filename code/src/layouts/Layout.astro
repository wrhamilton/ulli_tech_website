---
const navItems = [
  { label: 'Home', href: '/' },
  { label: 'About', href: '/about' },
  { label: 'Pricing', href: '/pricing' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="description"
      content="ULLItech provides break/fix support, custom software development, and hardware design and installation for businesses and property owners."
    />
    <meta name="generator" content={Astro.generator} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&family=Tomorrow:wght@400;500;700;800&display=swap"
      rel="stylesheet"
    />
    <title>ULLItech | IT Support, Software, and Hardware Solutions</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container nav-wrap">
        <a href="/" class="brand" aria-label="ULLItech home">
          <span class="brand-mark">U</span>
          <span>ULLItech</span>
        </a>

        <nav class="main-nav" aria-label="Main navigation">
          {navItems.map((item) => (
            <a href={item.href}>{item.label}</a>
          ))}
        </nav>

        <a class="cta-button small" href="mailto:hello@ullitechsolutions.com">Book a Call</a>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="container footer-inner">
        <div>
          <h3>ULLItech</h3>
          <p>Reliable IT support, custom software, and hardware installs for growing businesses.</p>
        </div>
        <div>
          <h4>Contact</h4>
          <ul>
            <li><a href="tel:+12145550134">(214) 555-0134</a></li>
            <li><a href="mailto:hello@ullitechsolutions.com">hello@ullitechsolutions.com</a></li>
            <li>Shelburne and Orangeville, Ontario, with service up to 50 miles from the midpoint between the two.</li>
          </ul>
        </div>
      </div>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --primary: #243b55;
    --primary-dark: #1d3048;
    --secondary: #243b55;
    --secondary-soft: #36577d;
    --teal: #5ecac3;
    --accent: #ff8d79;
    --surface: #fffaf5;
    --muted: #5f6776;
    --border: rgba(36, 59, 85, 0.1);
    --panel: #ffffff;
    --panel-soft: #f9f4ee;
    --shadow: 0 20px 48px rgba(52, 78, 99, 0.12);
  }

  * {
    box-sizing: border-box;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-family: 'Space Grotesk', 'Segoe UI', sans-serif;
    color: var(--secondary);
    background: linear-gradient(180deg, #fffdf9 0%, #f8f4ef 100%);
    line-height: 1.6;
  }

  h1,
  h2,
  h3,
  h4,
  .brand,
  .eyebrow,
  .cta-button,
  .ghost-button {
    font-family: 'Tomorrow', 'Segoe UI', sans-serif;
  }

  img {
    max-width: 100%;
    display: block;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  h1,
  h2,
  h3,
  h4,
  p {
    margin-top: 0;
  }

  .container {
    width: min(1120px, calc(100% - 2rem));
    margin: 0 auto;
  }

  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    backdrop-filter: blur(12px);
    background: rgba(255, 253, 249, 0.88);
    border-bottom: 1px solid rgba(36, 59, 85, 0.08);
  }

  .nav-wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 78px;
    gap: 1rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: 0.03em;
    color: var(--secondary);
  }

  .brand-mark {
    width: 2.1rem;
    height: 2.1rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 12px;
    background: linear-gradient(135deg, var(--primary), var(--teal));
    color: white;
    font-weight: 800;
    box-shadow: 0 12px 22px rgba(36, 59, 85, 0.2);
  }

  .main-nav {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    color: var(--secondary-soft);
    font-weight: 600;
  }

  .main-nav a {
    transition: color 0.2s ease;
  }

  .main-nav a:hover,
  .main-nav a:focus-visible {
    color: var(--primary-dark);
  }

  .cta-button,
  .ghost-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 999px;
    padding: 0.85rem 1.4rem;
    font-weight: 700;
    border: 2px solid rgba(36, 59, 85, 0.9);
    box-shadow: 4px 4px 0 rgba(36, 59, 85, 0.8);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  .cta-button {
    background: linear-gradient(135deg, var(--primary), var(--teal));
    color: white;
    box-shadow: 0 12px 24px rgba(36, 59, 85, 0.2);
  }

  .cta-button.small {
    padding: 0.7rem 1.1rem;
    font-size: 0.94rem;
  }

  .ghost-button {
    background: rgba(255, 255, 255, 0.5);
    border: 2px solid rgba(36, 59, 85, 0.9);
    color: var(--secondary);
  }

  .cta-button:hover,
  .ghost-button:hover,
  .cta-button:focus-visible,
  .ghost-button:focus-visible {
    transform: translateY(-2px) rotate(-0.5deg);
    box-shadow: 6px 6px 0 rgba(36, 59, 85, 0.7);
  }

  .page-shell {
    padding: 4rem 0 5rem;
  }

  .hero {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    align-items: center;
    gap: 2.5rem;
    padding: 3rem 0 2rem;
  }

  .eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    font-weight: 800;
    color: var(--primary-dark);
    background: rgba(94, 202, 195, 0.18);
    border-radius: 999px;
    padding: 0.5rem 0.8rem;
    margin-bottom: 1rem;
  }

  .hero h1,
  .page-header h1 {
    font-size: clamp(2.3rem, 6vw, 4.25rem);
    line-height: 1.06;
    letter-spacing: -0.06em;
    margin-bottom: 1rem;
    color: var(--secondary);
  }

  .hero p,
  .page-header p,
  .section-copy,
  .list {
    font-size: 1.06rem;
    color: var(--muted);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .hero-panel {
    background: linear-gradient(145deg, #f8efe7, #f1f7f8);
    border: 3px solid rgba(36, 59, 85, 0.9);
    border-radius: 28px;
    padding: 2rem;
    color: var(--secondary);
    box-shadow: 8px 8px 0 rgba(36, 59, 85, 0.8);
    transform: rotate(0.5deg);
  }

  .hero-panel .mini-label {
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    opacity: 0.8;
    margin-bottom: 0.75rem;
  }

  .hero-stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .stat {
    background: rgba(255, 255, 255, 0.7);
    border: 1px solid rgba(36, 59, 85, 0.08);
    border-radius: 18px;
    padding: 1rem;
  }

  .stat strong {
    font-size: 1.8rem;
    display: block;
    color: var(--secondary);
  }

  .stat span {
    color: var(--muted);
    font-size: 0.9rem;
  }

  .section {
    padding: 2rem 0 4rem;
  }

  .section-header {
    margin-bottom: 2rem;
  }

  .section-header h2 {
    font-size: clamp(2rem, 4vw, 2.8rem);
    letter-spacing: -0.05em;
    margin-bottom: 0.75rem;
  }

  .grid {
    display: grid;
    gap: 1.5rem;
  }

  .service-grid,
  .features-grid,
  .pricing-grid {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .card {
    background: var(--panel);
    border: 2px solid rgba(36, 59, 85, 0.9);
    border-radius: 20px;
    padding: 1.6rem;
    box-shadow: 6px 6px 0 rgba(36, 59, 85, 0.7);
    transform: rotate(-0.3deg);
  }

  .card h3 {
    font-size: 1.35rem;
    margin-bottom: 0.7rem;
  }

  .card p,
  .card li {
    color: var(--muted);
  }

  .card ul {
    margin: 0;
    padding-left: 1.1rem;
  }

  .card ul li + li {
    margin-top: 0.45rem;
  }

  .page-header {
    padding-top: 3rem;
    padding-bottom: 2rem;
  }

  .two-col {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    align-items: start;
  }

  .story-box,
  .info-box {
    background: var(--panel);
    border-radius: 26px;
    border: 3px solid rgba(36, 59, 85, 0.9);
    padding: 2rem;
    box-shadow: 8px 8px 0 rgba(36, 59, 85, 0.75);
  }

  .timeline {
    list-style: none;
    padding: 0;
    margin: 1.5rem 0 0;
    display: grid;
    gap: 1rem;
  }

  .timeline li {
    position: relative;
    padding-left: 1.5rem;
    color: var(--muted);
  }

  .timeline li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6rem;
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--accent), var(--teal));
  }

  .pricing-card {
    background: var(--panel);
    border-radius: 22px;
    border: 2px solid rgba(36, 59, 85, 0.9);
    padding: 2rem 1.5rem;
    box-shadow: 7px 7px 0 rgba(36, 59, 85, 0.7);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  .pricing-card.featured {
    background: linear-gradient(180deg, var(--secondary), var(--secondary-soft));
    color: white;
    border-color: rgba(255, 255, 255, 0.08);
  }

  .pricing-card.featured p,
  .pricing-card.featured li,
  .pricing-card.featured .price-note {
    color: rgba(255, 255, 255, 0.8);
  }

  .price {
    font-size: 2.2rem;
    font-weight: 800;
    letter-spacing: -0.05em;
    margin: 0.8rem 0;
  }

  .price small {
    font-size: 0.9rem;
    font-weight: 600;
  }

  .pricing-card ul {
    margin: 1rem 0 0;
    padding-left: 1.1rem;
  }

  .site-footer {
    border-top: 3px solid rgba(36, 59, 85, 0.9);
    background: #f6f0ea;
    padding: 2rem 0 3rem;
  }

  .footer-inner {
    display: flex;
    justify-content: space-between;
    gap: 2rem;
  }

  .site-footer h3,
  .site-footer h4 {
    margin-bottom: 0.75rem;
  }

  .site-footer p,
  .site-footer li,
  .site-footer a {
    color: var(--muted);
  }

  .site-footer ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.4rem;
  }

  @media (max-width: 900px) {
    .hero,
    .two-col,
    .service-grid,
    .features-grid,
    .pricing-grid {
      grid-template-columns: 1fr;
    }

    .footer-inner {
      flex-direction: column;
    }
  }

  @media (max-width: 640px) {
    .nav-wrap {
      flex-wrap: wrap;
      justify-content: center;
      padding: 0.9rem 0;
    }

    .main-nav {
      width: 100%;
      justify-content: center;
      flex-wrap: wrap;
    }

    .page-shell {
      padding-top: 2.5rem;
    }
  }
</style>
