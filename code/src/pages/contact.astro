---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="container page-shell">
    <header class="page-header">
      <span class="eyebrow">Contact</span>
      <h1>Let’s talk about what your business needs.</h1>
      <p>
        Whether you need a quick repair, a custom software solution, or a hardware install, I’m here to
        help. Reach out and I’ll be glad to talk through the next step.
      </p>
    </header>

    <section class="two-col">
      <div class="info-box">
        <h2>Get in touch</h2>
        <p>
          <strong>Phone:</strong> <a href="tel:+14374882190">437-488-2190</a><br />
          <strong>Email:</strong> <a href="mailto:will@ullitech.ca">will@ullitech.ca</a><br />
          <strong>Service area:</strong> Shelburne and Orangeville, Ontario and surrounding areas.
        </p>
        <div class="hero-actions">
          <a class="cta-button" href="mailto:will@ullitech.ca">Email Will</a>
          <a class="ghost-button" href="tel:+14374882190">Call now</a>
        </div>
      </div>

      <div class="story-box">
        <h2>What to expect</h2>
        <ul class="timeline">
          <li>A quick conversation about your issue, goal, or project</li>
          <li>Clear guidance on the best next step</li>
          <li>Friendly, practical support from Will and his team</li>
        </ul>
      </div>
    </section>
  </main>
</Layout>
