---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="container page-shell">
    <header class="page-header">
      <span class="eyebrow">Pricing</span>
      <h1>Simple pricing for the services your business needs.</h1>
      <p>
        Every project is scoped based on the work involved, but these are common starting points for
        quick service requests and technology projects.
      </p>
    </header>

    <section class="grid pricing-grid">
      <article class="pricing-card">
        <h3>Break / Fix</h3>
        <div class="price">$149/hr <small>starting</small></div>
        <p class="price-note">Diagnostic service call and initial troubleshooting.</p>
        <ul>
          <li>Standard on-site visit</li>
          <li>System diagnosis</li>
          <li>Repair estimate and recommendations</li>
        </ul>
      </article>

      <article class="pricing-card featured">
        <h3>Support Retainer</h3>
        <div class="price">$79 <small>/month</small></div>
        <p class="price-note">Ideal for ongoing business support and faster response times.</p>
        <ul>
          <li>Priority scheduling</li>
          <li>Remote troubleshooting</li>
          <li>Routine maintenance support</li>
        </ul>
      </article>

      <article class="pricing-card">
        <h3>Custom Software</h3>
        <div class="price">$1,200 <small>+ project</small></div>
        <p class="price-note">Custom tools and workflow automation built to fit your operations.</p>
        <ul>
          <li>Requirement review</li>
          <li>Project planning and build</li>
          <li>Implementation and support</li>
        </ul>
      </article>
    </section>

    <section class="section">
      <div class="info-box">
        <h2>Need something custom?</h2>
        <p>
          Hardware design, installations, and larger commercial projects are scoped individually based on
          facility needs, timeline, and complexity.
        </p>
        <div class="hero-actions">
          <a class="cta-button" href="mailto:hello@ullitechsolutions.com">Request a quote</a>
        </div>
      </div>
    </section>
  </main>
</Layout>
