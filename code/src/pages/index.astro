---
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <main class="container page-shell">
    <section class="hero">
      <div>
        <span class="eyebrow">Business IT support</span>
        <h1>Fast, reliable tech help when your systems need it most.</h1>
        <p>
          ULLItech is here for the people who need dependable tech support without the runaround.
          Whether it’s a quick repair, a custom solution, or a hardware install, Will and his team
          take the time to understand what your business really needs.
        </p>
        <div class="hero-actions">
          <a class="cta-button" href="mailto:hello@ullitechsolutions.com">Call Will</a>
          <a class="ghost-button" href="/pricing">View pricing</a>
        </div>
      </div>

      <div class="hero-panel" aria-label="Business service summary">
        <div class="mini-label">Why folks call Will</div>
        <h2>Service that keeps your operations moving.</h2>
        <div class="hero-stats">
          <div class="stat">
            <strong>24/7</strong>
            <span>Emergency response</span>
          </div>
          <div class="stat">
            <strong>On-site</strong>
            <span>Field support</span>
          </div>
          <div class="stat">
            <strong>Custom</strong>
            <span>Software builds</span>
          </div>
          <div class="stat">
            <strong>Local</strong>
            <span>Regional coverage</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section">
      <div class="section-header">
        <span class="eyebrow">Services</span>
        <h2>Technology support designed around your business.</h2>
      </div>

      <div class="grid service-grid">
        <article class="card">
          <h3>Break / Fix</h3>
          <p>
            Rapid troubleshooting and repair for computers, networks, printers, servers, and office
            equipment to minimize downtime and restore productivity.
          </p>
        </article>

        <article class="card">
          <h3>Custom Software</h3>
          <p>
            Tailored business tools, workflow automation, and system integrations built to match your
            processes and goals.
          </p>
        </article>

        <article class="card">
          <h3>Hardware Design &amp; Installation</h3>
          <p>
            Smart hardware planning, setup, and installation for offices, facilities, and secure
            commercial environments.
          </p>
        </article>
      </div>
    </section>

    <section class="section">
      <div class="two-col">
        <div class="story-box">
          <span class="eyebrow">Location</span>
          <h2>Based in the region and ready to respond.</h2>
          <p>
            We proudly serve Shelburne and Orangeville, Ontario, and the surrounding area within a 50
            mile radius from the midpoint between the two towns.
          </p>
          <ul class="timeline">
            <li>On-site service for offices, retail locations, and small businesses</li>
            <li>Coverage across Shelburne, Orangeville, and nearby communities</li>
            <li>Remote diagnostics and support when needed</li>
          </ul>
        </div>

        <div class="info-box">
          <span class="eyebrow">Contact</span>
          <h2>Let’s solve the issue before it slows your team down.</h2>
          <p>Talk with Will about a repair, a new system build, or a custom software project.</p>
          <p>
            <strong>Phone:</strong> <a href="tel:+12145550134">(214) 555-0134</a><br />
            <strong>Email:</strong> <a href="mailto:hello@ullitechsolutions.com">hello@ullitechsolutions.com</a><br />
            <strong>Service area:</strong> Shelburne and Orangeville, Ontario, plus nearby communities within 50 miles of the midpoint between them
          </p>
          <div class="hero-actions">
            <a class="cta-button" href="mailto:hello@ullitechsolutions.com">Call Will</a>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
